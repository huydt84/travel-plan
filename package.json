{
  "name": "trip-schedule-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "LOCAL_ADMIN_BYPASS=true next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "pnpm run lint && pnpm run test:unit && pnpm run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:e2e": "NO_COLOR= FORCE_COLOR= playwright test",
    "db:up:local": "node scripts/docker-local.mjs up",
    "db:down:local": "node scripts/docker-local.mjs down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:migrate:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/migrate.mjs",
    "trip:import": "node --env-file=.env scripts/import-trip.mjs",
    "trip:import:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/import-trip.mjs",
    "vercel:env": "node --env-file=.env scripts/sync-vercel-env.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:seed:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/seed.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@neondatabase/serverless": "^1.1.0",
    "ajv": "^8.20.0",
    "luxon": "^3.7.2",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql-template-tag": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.19.0"
  }
}

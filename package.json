{
  "name": "trip-schedule-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:admin": "LOCAL_ADMIN_BYPASS=true node scripts/dev-server.mjs --hostname 127.0.0.1",
    "dev:cleanup": "node scripts/dev-process-cleanup.mjs",
    "build": "next build",
    "start": "next start",
    "test": "pnpm run lint && pnpm run test:unit && pnpm run test:e2e",
    "test:quick": "pnpm run lint && pnpm run test:unit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:db": "playwright test tests/e2e/migrations.spec.mjs tests/e2e/store-contracts.spec.mjs tests/e2e/import-persistence.spec.mjs tests/e2e/schedule-persistence.spec.mjs tests/e2e/assistant-persistence.spec.mjs tests/e2e/notification-outbox.spec.mjs",
    "test:browser:smoke": "playwright test tests/e2e/routes.spec.mjs tests/e2e/admin-navigation.spec.mjs tests/e2e/public-schedule-editing.spec.mjs",
    "test:visual": "playwright test tests/e2e/responsive-audit.spec.mjs tests/e2e/assistant-design.spec.mjs tests/e2e/assistant-panel.spec.mjs tests/e2e/localization-review.spec.mjs",
    "test:full": "pnpm test",
    "db:up:local": "node scripts/docker-local.mjs up",
    "db:down:local": "node scripts/docker-local.mjs down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:migrate:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/migrate.mjs",
    "db:migration:new": "node scripts/create-migration.mjs",
    "trip:import": "node --env-file=.env scripts/import-trip.mjs",
    "trip:import:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/import-trip.mjs",
    "vercel:env": "node --env-file=.env scripts/sync-vercel-env.mjs",
    "deploy:prod": "pnpm run vercel:env && pnpm run db:migrate && pnpm exec vercel --prod --yes",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:seed:local": "NODE_ENV=development LOCAL_ADMIN_BYPASS=true node scripts/seed.mjs",
    "test:assistant:live": "node --env-file=.env scripts/assistant-smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "ajv": "^8.20.0",
    "luxon": "^3.7.2",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "node-pg-migrate": "^9.0.0",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql-template-tag": "^5.2.1",
    "workflow": "^4.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "vercel": "58.4.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.25.0"
  }
}

# `pnpm run vercel:env` syncs every entry below except names beginning with `LOCAL_`.
POSTGRES_URI=<NEON_POSTGRES_URI>
# Optional override for Docker Postgres. Local admin only accepts loopback hosts.
LOCAL_POSTGRES_URI=postgresql://travel:travel@127.0.0.1:55432/travel_local
# Optional local-only identity for contributor browser testing.
LOCAL_VIEWER_EMAIL=
LOCAL_VIEWER_NAME=
AUTH_GOOGLE_ID=<GOOGLE_OAUTH_CLIENT_ID>
AUTH_GOOGLE_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
AUTH_SECRET=<RANDOM_32_BYTE_SECRET>
AUTH_OWNER_EMAIL=<MY_EMAIL>
APP_URL=<YOUR_DEPLOYMENT_URL>
RESEND_API_KEY=<RESEND_SENDING_API_KEY>
CRON_SECRET=<RANDOM_16_BYTE_OR_LONGER_SECRET>
# Isolated owner/admin pilot. Keep false until migrations and provider keys are ready.
AGENTIC_V1_ENABLED=false
GEMINI_API_KEY=<GOOGLE_AI_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_MAPS_PLATFORM_API_KEY=<PLACES_AND_ROUTES_API_KEY>
